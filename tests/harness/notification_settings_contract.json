{
  "contract": "AUTH-NOTIFY-002",
  "version": 1,
  "status": "IMPLEMENTED_AND_SYNTHETIC_VERIFIED",
  "target_release": "0.7.10",
  "depends_on": "AUTH-NOTIFY-001",
  "principle": "wordpress_core_first",
  "verification": {
    "status": "PASS",
    "scope": "synthetic_wordpress",
    "prefixes": [
      "wp_",
      "non_default"
    ],
    "evidence_id": "d28853b554c5497eb50df18d7f24dffe",
    "report": ".harness/reports/latest.json"
  },
  "admin": {
    "menu_parent": "users",
    "section": "notifications",
    "api": "wordpress_settings_api",
    "capability": "manage_kklidi_members",
    "server_nonce_required": true,
    "editable_fields": [
      "subject",
      "body"
    ],
    "per_event_disable": false,
    "sender_policy_display": "read_only"
  },
  "storage": {
    "api": "wordpress_options",
    "option_name": "kklidi_members_notification_templates",
    "schema_version": 1,
    "autoload": false,
    "custom_table": false,
    "fallback": "gettext_defaults"
  },
  "transport": {
    "api": "wp_mail",
    "format": "text/plain",
    "sender": "wordpress_or_site_transport_default",
    "members_registers_global_sender_filters": false,
    "smtp_owned_by_members": false,
    "provider_credentials_stored": false
  },
  "events": {
    "registration_completed": {
      "editable": [
        "subject",
        "body"
      ],
      "allowed_placeholders": [
        "site_name",
        "login_url"
      ]
    },
    "password_changed": {
      "editable": [
        "subject",
        "body"
      ],
      "allowed_placeholders": [
        "site_name",
        "password_reset_url"
      ]
    },
    "withdrawal_requested": {
      "editable": [
        "subject",
        "body"
      ],
      "allowed_placeholders": [
        "site_name"
      ]
    },
    "withdrawal_finalized": {
      "editable": [
        "subject",
        "body"
      ],
      "allowed_placeholders": [
        "site_name"
      ]
    }
  },
  "validation": {
    "subject_max_chars": 200,
    "body_max_chars": 5000,
    "raw_html": false,
    "shortcodes": false,
    "php": false,
    "unknown_placeholders": "reject",
    "empty_or_invalid": "use_gettext_default"
  },
  "localization": {
    "default_source": "english_gettext",
    "catalog_text_domain": "kklidi-members",
    "render_locale": "wordpress_user_locale_with_site_fallback",
    "saved_override_policy": "site_specific_plain_text"
  },
  "security": {
    "recipient": "current_wordpress_user_email",
    "forbidden_values": [
      "password",
      "reset_key",
      "auth_cookie",
      "nonce",
      "wordpress_user_id",
      "role",
      "order_data",
      "lms_data"
    ],
    "settings_update_audit": "metadata_only_no_template_content",
    "mail_failure_behavior": "preserve_auth_notify_001"
  },
  "boundaries": {
    "wordpress_core_auth_preserved": true,
    "wordpress_user_ids_preserved": true,
    "wordpress_core_password_reset_mail_owned_by": "wordpress_core",
    "woocommerce_order_mail_owned_by": "woocommerce",
    "lms_learning_mail_owned_by": "lms",
    "kboard_mail_owned_by": "kboard",
    "members_optional_dependency": true,
    "global_frontend_bootstrap": false
  },
  "out_of_scope": [
    "email_verification",
    "email_change_verification",
    "wordpress_core_password_reset_mail_template",
    "admin_notification_recipients",
    "per_event_disable",
    "html_email",
    "wysiwyg_editor",
    "template_preview",
    "test_send",
    "retry_queue",
    "delivery_webhooks",
    "delivery_log",
    "smtp_settings",
    "provider_api",
    "provider_credentials",
    "global_sender_override",
    "woocommerce_order_mail",
    "lms_learning_mail",
    "kboard_mail"
  ]
}
