msgid "KKLIDI Members"
msgstr "KKLIDI Members"
msgid "KKLIDI Members currently supports single-site installations only."
msgstr "KKLIDI Members는 현재 단일 사이트 설치만 지원합니다."
msgid "You do not have permission to access this page."
msgstr "이 페이지에 접근할 권한이 없습니다."
msgid "We could not verify this request. Please reload the login page and try again."
msgstr "요청을 확인할 수 없습니다. 로그인 화면을 새로 열어 다시 시도해 주세요."
msgid "Enter your username or email and password."
msgstr "아이디 또는 이메일과 비밀번호를 입력해 주세요."
msgid "There have been too many login attempts. Please try again later."
msgstr "로그인 시도가 많습니다. 잠시 후 다시 시도해 주세요."
msgid "Please check your login details."
msgstr "로그인 정보를 확인해 주세요."
msgid "We could not verify this request."
msgstr "요청을 확인할 수 없습니다."
msgid "Please check your current password."
msgstr "현재 비밀번호를 확인해 주세요."
msgid "The new password must be at least 12 characters and match the confirmation."
msgstr "새 비밀번호는 12자 이상이어야 하며 확인 값과 같아야 합니다."
msgid "New registrations are currently closed."
msgstr "현재 신규 가입을 받고 있지 않습니다."
msgid "We could not verify this request. Please reload the registration page."
msgstr "요청을 확인할 수 없습니다. 가입 화면을 새로 열어 주세요."
msgid "Please try again later."
msgstr "잠시 후 다시 시도해 주세요."
msgid "There have been too many registration attempts. Please try again later."
msgstr "가입 요청이 많습니다. 잠시 후 다시 시도해 주세요."
msgid "Please check the registration details."
msgstr "가입 정보를 확인해 주세요."
msgid "The password must be at least 12 characters and match the confirmation."
msgstr "비밀번호는 12자 이상이어야 하며 확인 값과 같아야 합니다."
msgid "Please accept the required terms and privacy policy."
msgstr "필수 약관과 개인정보 처리방침에 동의해 주세요."
msgid "Another registration request is being processed. Please try again later."
msgstr "가입 요청을 처리 중입니다. 잠시 후 다시 시도해 주세요."
msgid "We could not complete the registration. Please use login or password reset."
msgstr "가입 요청을 처리할 수 없습니다. 로그인 또는 비밀번호 찾기를 이용해 주세요."
msgid "Registration is incomplete. Please try again from this page."
msgstr "가입을 완료하지 못했습니다. 같은 화면에서 다시 시도해 주세요."
msgid "Please review and accept the required consent documents."
msgstr "필수 동의 문서를 확인하고 동의해 주세요."
msgid "We could not save the required consent."
msgstr "필수 동의를 저장하지 못했습니다."
msgid "We could not save the optional consent."
msgstr "선택 동의를 저장하지 못했습니다."
msgid "We could not save the optional consent withdrawal."
msgstr "선택 동의 철회를 저장하지 못했습니다."
msgid "Your consent settings have been saved."
msgstr "동의 상태를 저장했습니다."
msgid "This document type is not supported."
msgstr "지원하지 않는 문서 유형입니다."
msgid "A document version and content are required."
msgstr "문서 버전과 본문이 필요합니다."
msgid "The saved content differs for the same document hash."
msgstr "같은 문서 해시의 저장 내용이 다릅니다."
msgid "We could not save the document."
msgstr "문서를 저장하지 못했습니다."
msgid "We could not set the current document."
msgstr "현재 문서를 지정하지 못했습니다."
msgid "Please check the display name or phone number format."
msgstr "표시명 또는 전화번호 형식을 확인해 주세요."
msgid "We could not save your profile."
msgstr "프로필을 저장하지 못했습니다."
msgid "Your profile has been saved."
msgstr "프로필을 저장했습니다."
msgid "This account is not available."
msgstr "계정을 사용할 수 없습니다."
msgid "We could not process this request. Please try again later."
msgstr "요청을 처리할 수 없습니다. 잠시 후 다시 시도해 주세요."
msgid "Administrator accounts require separate manual review for withdrawal."
msgstr "관리자 계정의 탈퇴는 별도 수동 검토가 필요합니다."
msgid "We could not save the withdrawal request."
msgstr "탈퇴 요청 상태를 저장하지 못했습니다."
