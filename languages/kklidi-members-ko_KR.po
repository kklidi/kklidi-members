msgstr "URL 소유권 저장"

msgid "The clean route setting could not be applied. The previous route setting remains active."
msgstr "전용주소 설정을 적용하지 못했습니다. 이전 라우트 설정이 계속 적용됩니다."

msgid "The clean route setting could not be saved."
msgstr "전용주소 설정을 저장하지 못했습니다."

msgid "Use fixed member URLs without creating WordPress pages or shortcodes. Existing query URLs remain available as a fallback."
msgstr "WordPress 페이지나 숏코드를 만들지 않고 고정 회원 URL을 사용합니다. 기존 쿼리 URL은 대체 경로로 계속 사용할 수 있습니다."

msgid "WordPress URL ownership"
msgstr "WordPress URL 소유권"

msgid "WordPress could not persist the member route rules."
msgstr "WordPress가 회원 라우트 규칙을 저장하지 못했습니다."

msgid "You do not have permission to manage member routes."
msgstr "회원 라우트를 관리할 권한이 없습니다."

msgid "Enter your account details to continue."
msgstr "계정 정보를 입력해 계속하세요."

msgid "Create an account, then sign in with your email address."
msgstr "계정을 만든 후 이메일 주소로 로그인하세요."

msgid "Enter your username or email to receive a reset link."
msgstr "사용자명 또는 이메일을 입력하면 재설정 링크를 보내드립니다."
